<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{% block title %}{{ module_title | default('Catalyst') }}{% endblock %}</title>

    {% block meta %}
    {% endblock %}

    {% if tailwind_config and tailwind_config.cdn_enabled %}
    <!-- Tailwind CSS -->
    <script src="{{ tailwind_config.cdn_url }}"></script>
    {% endif %}

    {% for css_file in (tailwind_config.custom_css if tailwind_config else []) %}
    <link rel="stylesheet" href="{{ css_file }}">
    {% endfor %}

    {% if htmx_config and htmx_config.cdn_enabled %}
    <!-- HTMX -->
    <script src="{{ htmx_config.cdn_url }}"></script>
    {% endif %}

    {% for extension in (htmx_config.extensions if htmx_config else []) %}
    <!-- HTMX Extension -->
    <script src="{{ extension }}"></script>
    {% endfor %}

    {% block head_scripts %}
    {% endblock %}

    {% block styles %}
    <style>
        /* Ensure full viewport usage */
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }
        
        /* Base scrollbar styling */
        .custom-scrollbar::-webkit-scrollbar {
            width: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.1);
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(0, 0, 0, 0.5);
        }

        /* Base markdown content styling */
        .markdown-content h1 { @apply text-3xl font-bold mt-6 mb-4 text-gray-900; }
        .markdown-content h2 { @apply text-2xl font-bold mt-5 mb-3 text-gray-800; }
        .markdown-content h3 { @apply text-xl font-semibold mt-4 mb-2 text-gray-800; }
        .markdown-content h4 { @apply text-lg font-semibold mt-3 mb-2 text-gray-700; }
        .markdown-content p { @apply mb-3 text-gray-700 leading-relaxed; }
        .markdown-content ul { @apply list-disc list-inside mb-3 ml-4 text-gray-700; }
        .markdown-content ol { @apply list-decimal list-inside mb-3 ml-4 text-gray-700; }
        .markdown-content li { @apply mb-1; }
        .markdown-content blockquote { @apply border-l-4 border-blue-400 pl-4 py-2 my-3 italic text-gray-600 bg-gray-50; }
        .markdown-content code:not([class*="language-"]) {
            @apply px-1.5 py-0.5 bg-gray-100 rounded text-sm font-mono text-red-600;
        }
        .markdown-content pre { @apply bg-gray-900 text-gray-100 rounded-lg p-4 my-3 overflow-x-auto; }
        .markdown-content a { @apply text-blue-600 hover:text-blue-800 underline; }
        .markdown-content hr { @apply my-4 border-gray-300; }
        .markdown-content table { @apply w-full border-collapse my-3; }
        .markdown-content th { @apply border border-gray-300 px-3 py-2 bg-gray-100 text-left; }
        .markdown-content td { @apply border border-gray-300 px-3 py-2; }
        .markdown-content img { @apply max-w-full h-auto rounded-lg shadow-md my-3; }
    </style>
    {% endblock %}
</head>
<body class="{% block body_class %}bg-white text-gray-900{% endblock %}"
      {% if htmx_config %}
      hx-headers='{"X-Module-Prefix": "{{ module_prefix }}"}'
      {% endif %}>

    {% block header %}
    {% endblock %}

    {% block content %}
    {% endblock %}

    {% block footer %}
    {% endblock %}

    {% block scripts %}
    <script>
        // Base configuration from server
        window.CatalystConfig = {
            {% if module_prefix %}
            modulePrefix: "{{ module_prefix }}",
            {% endif %}
            {% if module_title %}
            moduleTitle: "{{ module_title }}",
            {% endif %}
            {% if htmx_config %}
            htmx: {
                defaultSwap: "{{ htmx_config.default_swap }}",
                defaultTrigger: "{{ htmx_config.default_trigger }}",
                triggerPatterns: {{ htmx_config.trigger_patterns | tojson }}
            },
            {% endif %}
            {% if tailwind_config %}
            tailwind: {
                enabled: {{ tailwind_config.cdn_enabled | lower }}
            }
            {% endif %}
        };

        // Apply HTMX defaults if available
        document.addEventListener('DOMContentLoaded', function() {
            {% if htmx_config %}
            if (typeof htmx !== 'undefined') {
                htmx.config.defaultSwapStyle = "{{ htmx_config.default_swap }}";

                // Log config for debugging
                console.debug('Catalyst module initialized:', window.CatalystConfig);
            }
            {% endif %}
        });
    </script>
    {% endblock %}
</body>
</html>
